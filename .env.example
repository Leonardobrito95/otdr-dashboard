# SmartOLT (fonte de status de ONU/OLT)
SMARTOLT_URL=
SMARTOLT_KEY=

# IXC (MySQL, billing/cadastro)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Banco do sistema (Postgres, histórico e estado)
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# SMTP (alertas internos por e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTDR_ALERT_EMAIL=
OTDR_SAUDE_EMAIL=
OTDR_ESCALONAMENTO_EMAIL=

# WhatsApp (Meta Cloud API, escalonamento interno)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=
WHATSAPP_TO=
WHATSAPP_ESCALON_TO=

# SYNKR (aviso automático ao cliente final)
SYNKR_URL=
SYNKR_LOGIN=
SYNKR_PASSWORD=
SYNKR_BUSINESS_NAME=
SYNKR_DEADLINE_HORAS=24

# IA (causa provável do problema, usado no dashboard)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Dashboard (Flask)
FLASK_SECRET_KEY=
OTDR_SSO_SECRET=

# Limites e thresholds (todos têm default no código, ajuste se precisar)
OTDR_POLL_INTERVAL=420
OTDR_COOLDOWN_SEC=1800
OTDR_ALERTA_MIN_QTD=10
OTDR_ALERTA_MIN_QTD_POWER=100
OTDR_ALERTA_MIN_PCT=30
OTDR_SPLIT_LIMITE=8
OTDR_SAUDE_ATENCAO=85
OTDR_SAUDE_CRITICO=70
OTDR_SAUDE_COOLDOWN=3600
OTDR_SAUDE_CAUSA_DOMINANTE_PCT=70
OTDR_SAUDE_CLIENTE_ENERGIA_PCT=40
OTDR_SLA_ATENCAO_DIAS=2
OTDR_SLA_CRITICO_DIAS=5
OTDR_ESCALONAMENTO_HORAS=4
OTDR_CACHE_REFRESH=3600
