# OTDR Dashboard, configuração (copie para .env e preencha)

# --- SmartOLT API ---
SMARTOLT_URL=https://seu-tenant.smartolt.com/api
SMARTOLT_KEY=

# --- MySQL (IXC, leitura) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ixc
MYSQL_USER=
MYSQL_PASSWORD=

# --- PostgreSQL (histórico OTDR) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=otdr
PG_USER=
PG_PASSWORD=

# --- Alertas autônomos ---
OTDR_POLL_INTERVAL=300
OTDR_COOLDOWN_SEC=3600
OTDR_ALERT_EMAIL=alertas@exemplo.com.br

# --- SMTP (e-mail de alerta) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=otdr@exemplo.com.br
